---
/** Every calculator page and guide (src/content/pages/<id>.ts). */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/pages';
import type { PageDef } from '../../lib/page-types';
export function getStaticPaths() { return PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} />
